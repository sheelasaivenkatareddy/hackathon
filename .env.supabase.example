# Copy this file to .env.supabase and fill it in. .env.supabase is never committed.

# Required. Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional: turns on AI vision (finding and circling spots, plant check, care plan).
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# The admin who can see every scan at /admin. The password is generated and saved to admin-credentials.txt.
ADMIN_EMAIL=

# Optional: use an existing project instead of creating "patra-lens".
# SUPABASE_PROJECT_REF=
# SUPABASE_REGION=ap-south-1
